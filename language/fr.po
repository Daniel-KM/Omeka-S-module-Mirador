msgstr "Mirador : Ignorer le css par défaut"

#: src/Form/SiteSettingsFieldset.php:37
msgid "Display Mirador viewer"
msgstr "Afficher la visionneuse Mirador"

#: src/Form/SiteSettingsFieldset.php:39
msgid "Item show"
msgstr "Contenu / vue"

#: src/Form/SiteSettingsFieldset.php:40
msgid "Item browse"
msgstr "Contenu / liste"

#: src/Form/SiteSettingsFieldset.php:41
msgid "Item set browse"
msgstr "Collection / liste"

