#: Module.php:46
#, php-format
msgid "The module %1$s should be upgraded to version %2$s or later."
msgstr "Le module %1$s doit être mis à niveau à la version %2$s ou supérieure."

#: data/scripts/upgrade.php:32 data/scripts/upgrade.php:94
msgid "Missing requirement. Unable to upgrade."
msgstr "Pré-requis absent. Impossible de mettre à jour."

#: data/scripts/upgrade.php:90
msgid "This module requires the module {module}, version {version} or above."
msgstr ""
"Ce module requiert le module « {module} », version {version} ou supérieure."

#: data/scripts/upgrade.php:98
msgid "The module supports audio and video for Mirador v3."
msgstr "Le module gère l’audio et la vidéo pour Mirador v3."

#: data/scripts/upgrade.php:124
msgid "The module supports Mirador v4."
msgstr "Le module gère désormais Mirador v4."

#: data/scripts/upgrade.php:129
msgid "Warning: if you customized theme, note that settings were renamed."
msgstr ""
"Attention : si vous avez personnalisé les thèmes, notez que les noms des "
"paramètres ont été modifiés."

#: data/scripts/upgrade.php:136
msgid ""
"Mirador v4 now uses ecmascript modules with import maps instead of pre-"
"compiled bundles. Plugins are now loaded individually and locally, in a GDPR-"
"compliand way."
msgstr ""
"Mirador v4 utilise désormais les modules ecmascript avec des cartes d’import "
"et non plus des paquets précompilés. Les extensions sont désormais chargées "
"individuellement et localement, de façon compatible avec la RGPD."

#: data/scripts/upgrade.php:151
msgid ""
"A new option allows to set the placement of the viewer on item show and "
"browse pages."
msgstr ""
"Un nouvelle option permet de définir la position de la visionneuse sur la "
"page de contenu et sur les listes."

#: data/scripts/upgrade.php:205
msgid ""
"Mirador version was not updated to v4 for {list} because custom v2/v3 "
"plugins or config were found. Please check and update manually."
msgstr ""
"Mirador n’a pas été mis à jour à v4 pour {list} en raison d’une "
"personnalisation de la config ou des plugins. Vérifier pour mettre à jour si "
"besoin."

#: data/scripts/upgrade.php:211
msgid "Mirador version has been set to v4 for all settings and sites."
msgstr "Mirador v4 a été défini pour tous les sites."

#: data/scripts/upgrade.php:269
msgid ""
"Mirador v3 kept for {list} due to a custom v3 JSON config. Review and "
"migrate manually."
msgstr ""
"Mirador v3 a été conservé pour {list} en raison d’une personnalisation de la "
"config. Vérifier pour mettre à jour si besoin."

#: data/scripts/upgrade.php:277
msgid ""
"Mirador forced to v4 for {list}. v3 plugins copied to v4 plugins. You may "
"review the migration."
msgstr ""
"Mirador a forcé la mise à jour vers v4 pour {list}. Les extensions v3 ont "
"été appliquées pour v4. Vous pouvez vérifier la migration."

#: data/scripts/upgrade.php:284
msgid ""
"Mirador v4 now includes all plugins from Mirador v3 and some other ones, in "
"particular image cropper, ocr helper and physical ruler."
msgstr ""
"Mirador v4 inclut désormais toutes les extensions de Mirador v3 et quelques "
"autres, en particulier le recadreur d’image, l’assistant ocr et la règle "
"physique."

#: data/plugins/plugins.php:18
msgid "Image cropper"
msgstr "Recadreur d’image"

#: data/plugins/plugins.php:20
msgid "OCR helper (text panel)"
msgstr "Assistant OCR (panneau texte)"

#: data/plugins/plugins.php:21
msgid "Rotation"
msgstr "Rotation"

#: data/plugins/plugins.php:22
msgid "Physical ruler"
msgstr "Règle physique"

#: data/plugins/plugins.php:24
msgid "Synchronize windows"
msgstr "Synchronisation des fenêtres"

#: data/plugins/plugins.php:25
msgid "Text overlay (OCR)"
msgstr "Couche texte (OCR)"

#: data/plugins/plugins.php:26
msgid "Zoom percentage"
msgstr "Pourcentage du zoom"

#: Module.php:58
msgid ""
"The library \"{library}\" should be installed. See module’s installation "
"documentation."
msgstr ""
"La bibliothèque « {library} » doit être installée. Consulter la "
"documentation d’installation du module."

#: src/View/Helper/Mirador.php:278
msgid "Settings for Mirador config of items is not a valid json."
msgstr ""
"Les paramètres de la configuration de Mirador pour les contenus ne sont pas "
"un json valide."

#: src/View/Helper/Mirador.php:297
msgid "Settings for Mirador config of collections is not a valid json."
msgstr ""
"Les paramètres de la configuration de Mirador pour les collections ne sont "
"pas un json valide."

